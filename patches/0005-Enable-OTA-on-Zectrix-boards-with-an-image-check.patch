@@ -129,7 +129,21 @@ bool FirmwareUpdateService::performFirmwareUpdate() {
       if (Update.begin(contentLength)) {
         Log_info("%s [%d]: Firmware update start\r\n", __FILE__, __LINE__);
 
-        if (Update.writeStream(https->getStream())) {
+#ifdef BOARD_ZECTRIX
+        ZectrixImageCheck imageCheck(https->getStream());
