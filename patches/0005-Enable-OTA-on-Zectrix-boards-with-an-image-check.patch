diff --git a/src/zectrix.cpp b/src/zectrix.cpp
index 06072df..2ebd606 100644
--- a/src/zectrix.cpp
+++ b/src/zectrix.cpp
@@ -105,6 +105,42 @@ void start_charge_led() {
 
 } // namespace
 
+ZectrixImageCheck::ZectrixImageCheck(Stream &source)
+    : _source(source), _length(strlen(ZECTRIX_IMAGE_ID)) {
+  static_assert(sizeof(ZECTRIX_IMAGE_ID) - 1 <= sizeof(_fallback), "image ID too long");
+  // KMP failure table, so a match that starts inside a partial match is found.
+  _fallback[0] = 0;
+  for (size_t i = 1, k = 0; i < _length; i++) {
+    while (k > 0 && ZECTRIX_IMAGE_ID[i] != ZECTRIX_IMAGE_ID[k]) k = _fallback[k - 1];
+    if (ZECTRIX_IMAGE_ID[i] == ZECTRIX_IMAGE_ID[k]) k++;
+    _fallback[i] = k;
+  }
+}
+
+void ZectrixImageCheck::scan(const uint8_t *data, size_t length) {
+  for (size_t i = 0; i < length && !found(); i++) {
+    while (_matched > 0 && data[i] != static_cast<uint8_t>(ZECTRIX_IMAGE_ID[_matched])) {
+      _matched = _fallback[_matched - 1];
+    }
+    if (data[i] == static_cast<uint8_t>(ZECTRIX_IMAGE_ID[_matched])) _matched++;
+  }
+}
+
+int ZectrixImageCheck::read() {
+  int c = _source.read();
+  if (c >= 0) {
+    uint8_t b = static_cast<uint8_t>(c);
+    scan(&b, 1);
+  }
+  return c;
+}
+
+size_t ZectrixImageCheck::readBytes(char *buffer, size_t length) {
+  size_t n = _source.readBytes(buffer, length);
+  scan(reinterpret_cast<const uint8_t *>(buffer), n);
+  return n;
+}
+
 bool zectrix_is_charging() { return rtc_gpio_get_level(ZECTRIX_CHARGING_GPIO) == 0; }
 
 bool zectrix_is_charged() { return rtc_gpio_get_level(ZECTRIX_CHARGED_GPIO) != 0; }
